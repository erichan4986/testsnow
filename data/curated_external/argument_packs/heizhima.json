        },
        {
          "schema_version": "curated_external_source_unit.v1",
          "unit_id": "external-unit:curated-source:zhihu_selected_observation:0a1df79e774442ab:12:156575b51b3f624f",
          "text": "这类合作的现实意义在于，L4自动驾驶已经不再是单纯技术展示。",
          "unit_hash": "156575b51b3f624f24dd8363c04a694a80f310e3a3bbaff5fadc2d835002ccf9",
          "source_id": "curated-source:zhihu_selected_observation:0a1df79e774442ab",
